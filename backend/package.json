{
  "name": "task-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Task & Engagement Management Tool",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
